# Optional. Copy to .env and fill in what you need.

# Only needed if auto-detection cannot find your sideloaded WebDriverAgent.
WDA_BUNDLE_ID=

# Opt-in: lets helpers.unlock() type your passcode to unlock the phone.
# Leave empty to keep unlocking manual.
PHONE_PASSCODE=

# Prompt-injection gate. Default for this machine; the viewer's "Approve sends"
# toggle overrides it live and wins.
#   always   every send after the agent read your phone waits for a click
#   flagged  only asks when the scanner found something. Quieter, but a payload
#            written to dodge the checks gets through
#   off      never asks. STOP and the activity feed are all that is left
# Anything unrecognized falls back to always.
SEND_APPROVAL=

# Seconds a gated send waits for you to click Approve in the viewer before it
# gives up and refuses to send. A send the agent asks for after reading your
# phone is gated; one you type into the viewer yourself is not. Default 120.
SEND_APPROVAL_TIMEOUT=

# Viewer port. Default 8770 (8765 belongs to the Practical Systems API).
VIEWER_PORT=

# Post-gesture waits, applied when the shared WDA session is created.
# Defaults (measured on device): idle wait 2s, animation cool-off 0.
# Raise WDA_ANIM_COOLOFF back toward 2 if agents misread busy screens.
WDA_IDLE_WAIT=
WDA_ANIM_COOLOFF=

# How long a tap holds the finger down, in milliseconds. Default 80. Lower is a
# slightly faster tap, but a contact that is too brief is silently DROPPED by
# iOS and a missed tap is worse than a slow one. The passcode pad ignores this.
WDA_TAP_HOLD_MS=

# Keystrokes per second the phone synthesises when the agent types. Default 60,
# which is WebDriverAgent's own default, so leaving this empty changes nothing.
# Raising it makes long messages type faster, but iOS silently DROPS keystrokes
# above some per-device rate and a message that typed wrong is refused, not
# sent. Only raise it if you have checked the text arrives character-perfect.
WDA_TYPING_FREQ=

# Live-view stream tuning. Defaults: 60 fps requested (~34 real, WDA's max),
# JPEG quality 70, frames scaled to 50%. Raise MJPEG_SCALE if you need a
# sharper capture; lower it if the stream lags on your machine.
MJPEG_FPS=
MJPEG_QUALITY=
MJPEG_SCALE=

# Seconds between the viewer's periodic /api/phone poll (battery, lock state,
# which app is frontmost, and the Go-to-page chips). Default 0 = off: the
# viewer still reads it once when the page loads. Each tick costs one
# active-app read, plus a page-indicator read while the Home Screen is
# frontmost. Both resolve the active application, which is the call an app
# like TikTok can hang, so a poll left running is also what can wedge the
# link with no agent involved. 10 is a reasonable value if you want it live.
VIEWER_PHONE_POLL_SECONDS=

# Seconds WebDriverAgent waits for an app's main run loop to answer before it
# gives up on a call (WDA setting accessibilityDeadline). Default 2.0. It is a
# run-loop responsiveness pre-check, NOT a bound on the snapshot itself, so it
# does not cure a wedged app; it only stops some calls queueing behind one that
# has stopped answering. 0 disables the bound. Needs a WebDriverAgent new
# enough to know the setting; if the whole settings call is rejected the
# harness prints a warning and carries on with WDA's defaults.
WDA_ACCESSIBILITY_DEADLINE=
