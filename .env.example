# Optional. Copy to .env and fill in what you need.

# Only needed if auto-detection cannot find your sideloaded WebDriverAgent.
WDA_BUNDLE_ID=

# Opt-in: lets helpers.unlock() type your passcode to unlock the phone.
# Leave empty to keep unlocking manual.
PHONE_PASSCODE=

# Viewer port. Default 8770 (8765 belongs to the Practical Systems API).
VIEWER_PORT=
